// moonflac-encoder — pure MoonBit FLAC encoder.
// Documentation: https://docs.moonbitlang.com/en/latest/toolchain/moon/module.html

name = "Sakuraqwq1/moonflac-encoder"

version = "0.5.0"

readme = "README.md"

repository = "https://github.com/Sakuraqwq1/moonflac-encoder"

license = "Apache-2.0"

keywords = [
  "flac",
  "audio",
  "codec",
  "lossless",
  "encoder",
  "rice",
  "lpc",
  "pcm",
]

description = "Pure MoonBit FLAC encoder: turn interleaved PCM into a native .flac stream with fixed and LPC prediction, Rice partitioned residuals and stereo decorrelation."
